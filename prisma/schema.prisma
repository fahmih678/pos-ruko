// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         String        @default("CASHIER") // OWNER or CASHIER
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  shifts       Shift[]
  transactions Transaction[]
}

model StoreSetting {
  id            String   @id @default("default-store")
  storeName     String   @default("Toko Ruko Berkah")
  address       String   @default("Jl. Niaga Ruko Blok A No. 8")
  phone         String   @default("081234567890")
  receiptFooter String   @default("Terima kasih telah berbelanja! Barang yang sudah dibeli tidak dapat ditukar/dikembalikan.")
  qrisImageUrl  String?
  qrisText      String?
  updatedAt     DateTime @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id            String            @id @default(cuid())
  name          String
  sku           String?           @unique
  costPrice     Float             @default(0)
  sellPrice     Float
  stock         Int               @default(0)
  minStockAlert Int               @default(5)
  category      Category?         @relation(fields: [categoryId], references: [id])
  categoryId    String?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  orderItems    TransactionItem[]
}

model Shift {
  id                 String        @id @default(cuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id])
  openedAt           DateTime      @default(now())
  closedAt           DateTime?
  startingCash       Float         @default(0)
  endingCashExpected Float?
  endingCashActual   Float?
  status             String        @default("OPEN") // OPEN or CLOSED
  notes              String?
  transactions       Transaction[]
}

model Transaction {
  id            String            @id @default(cuid())
  invoiceNumber String            @unique
  shiftId       String?
  shift         Shift?            @relation(fields: [shiftId], references: [id])
  userId        String
  user          User              @relation(fields: [userId], references: [id])
  totalAmount   Float
  paymentMethod String            @default("CASH") // CASH, QRIS, TRANSFER
  paidAmount    Float
  changeAmount  Float             @default(0)
  customerName  String?
  status        String            @default("COMPLETED")
  createdAt     DateTime          @default(now())
  items         TransactionItem[]
}

model TransactionItem {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?    @relation(fields: [productId], references: [id])
  productName   String
  quantity      Int
  costPrice     Float       @default(0)
  sellPrice     Float
  subtotal      Float
}

